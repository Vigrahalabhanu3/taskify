# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/taskify

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_signing_key_taskify_2026
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000

# Cloudinary Integration (File Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenWeatherMap Integration (Live Weather Lookup)
OPENWEATHER_API_KEY=your_openweather_api_key

# Email Integration (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Taskify Team <noreply@taskify.app>"
